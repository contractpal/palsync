    "palpush": "./palpush.js"
  },
  "main": "palpush.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "src/",
    "lib/",
    "pi-extension/",
    "bundled-context/",
    "eval/specs/",
    "eval/impact/",
