  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "acorn": "^8.16.0",
    "fast-xml-parser": "^5.9.3",
