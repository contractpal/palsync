{
  "name": "palsync-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Electron GUI wrapper for palsync — workspace/tab manager over real agent-CLI consoles.",
  "main": "src/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev": "concurrently -k -n renderer,electron -c cyan,yellow \"npm:dev:renderer\" \"electron .\"",
    "build:renderer": "vite build",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:win:dir": "npm run build:renderer && electron-builder --win --dir",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:mac:dir": "npm run build:renderer && electron-builder --mac --dir",
    "postinstall": "patch-package && electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "palsync": "file:..",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "patch-package": "^8.0.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.contractpal.chip-pal-builder",
    "productName": "Chip Pal Builder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-renderer/**/*",
      "src/main/**/*",
      "package.json",
      "build-info.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "ChipPalBuilder.exe"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true,
    "file:../..": false
  }
}
